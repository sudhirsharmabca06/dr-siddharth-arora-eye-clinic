---
const galleryItems = [
  { label: 'Clinic Exterior', placeholder: 'clinic-building', image: 'images/exterior.jpg' },
  { label: 'Reception Area', placeholder: 'reception', image: 'images/reception_area.jpg' },
  { label: 'Consultation Room', placeholder: 'consultation', image: 'images/cons_room.jpg' },
  { label: 'Diagnostic Equipment', placeholder: 'equipment' },
  { label: 'Doctor with Patient', placeholder: 'doctor-patient' },
  { label: 'Our Team', placeholder: 'team' },
];
---

<section id="gallery" class="section-padding bg-surface">
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">Gallery</span>
      <h2 class="text-3xl md:text-4xl font-bold text-heading mt-2 mb-4">
        Take a Tour of Our Clinic
      </h2>
      <p class="text-body text-lg">
        A glimpse into our modern facilities and caring environment in Bharatpur.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {galleryItems.map((item, index) => (
        <div class="group relative bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] bg-gray-100 flex items-center justify-center">
            {item.image ? (
              <img
                src={item.image}
                alt={`${item.label} at Dr Siddharth Arora Eye Clinic`}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="text-center p-6">
                <div class="w-16 h-16 mx-auto mb-3 bg-primary/10 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
                <p class="text-primary font-medium text-sm">{item.label}</p>
                <p class="text-xs text-gray-400 mt-1">Add photo to /public/images/</p>
              </div>
            )}
          </div>
          <div class="absolute inset-0 bg-primary/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <span class="text-white font-semibold text-lg">{item.label}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <p class="text-sm text-body bg-white inline-block px-6 py-3 rounded-full border border-gray-200">
        <span class="text-primary font-semibold">Tip:</span> Replace these placeholders with your actual photos by placing them in the <code class="bg-gray-100 px-2 py-0.5 rounded text-xs">public/images/</code> folder.
      </p>
    </div>
  </div>
</section>
