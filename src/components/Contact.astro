---

<section id="contact" class="section-padding bg-white">
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">Contact Us</span>
      <h2 class="text-3xl md:text-4xl font-bold text-heading mt-2 mb-4">
        Visit Our Clinic
      </h2>
      <p class="text-body text-lg">
        We are here to help you see better. Reach out to us for appointments and inquiries.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="bg-surface rounded-xl p-6 md:p-8 border border-gray-100">
          <h3 class="text-xl font-bold text-heading mb-6">Clinic Information</h3>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0D7377" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="font-semibold text-heading text-sm">Address</p>
                <p class="text-body text-sm mt-0.5">169, Krishna Nagar, Bharatpur, Rajasthan 321001</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0D7377" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-heading text-sm">Phone</p>
                <a href="tel:9587456565" class="text-primary font-medium text-sm mt-0.5 hover:underline">+91 95874 56565</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0D7377" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <p class="font-semibold text-heading text-sm">Clinic Hours</p>
                <p class="text-body text-sm mt-0.5">Monday - Saturday<br/>Morning: 8:00 AM - 1:00 PM</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick CTA -->
        <div class="bg-primary rounded-xl p-6 md:p-8 text-white text-center">
          <h3 class="text-xl font-bold mb-2">Need Urgent Eye Care?</h3>
          <p class="text-primary-light/90 text-sm mb-5">Call us directly for immediate assistance and appointment booking.</p>
          <a href="tel:9587456565" class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary font-bold rounded-lg hover:bg-gray-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call: 95874 56565
          </a>
        </div>
      </div>

      <!-- Google Maps -->
      <div class="bg-surface rounded-xl overflow-hidden border border-gray-100 h-full min-h-[400px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3548.065066642918!2d77.5085002741706!3d27.21710687646705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3973a3727046e627%3A0xb981c5020493f816!2sDr%20Siddharth%20Arora%20-%20Ophthalmologist%20(Eye%20Specialist)!5e0!3m2!1sen!2sin!4v1786908111485!5m2!1sen!2sin"
          class="w-full h-full min-h-[400px]"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Dr Siddharth Arora Eye Clinic location on Google Maps"
        ></iframe>
      </div>
    </div>
  </div>
</section>
