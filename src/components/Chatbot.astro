---
const agentName = 'Dr Siddharth Chatbot Agent';
const phone = '9413133943';
const phoneDisplay = '+91 94131 33943';
const address = '169, Krishna Nagar, Bharatpur, Rajasthan 321001';

const quickReplies = [
  { id: 'hours', label: 'Clinic Hours' },
  { id: 'address', label: 'Address' },
  { id: 'services', label: 'Services' },
  { id: 'appointment', label: 'Book Appointment' },
  { id: 'contact', label: 'Contact Number' },
];

const responses: Record<string, string> = {
  greeting:
    `Hello! I'm ${agentName}. I can help with clinic hours, location, services, and appointments. Choose a topic below or type your question.`,
  hours:
    'Our clinic is open Monday through Saturday, 8:00 AM to 1:00 PM. We recommend calling ahead to schedule an appointment and reduce waiting time.',
  address: `You can find us at:\n${address}`,
  contact: `You can reach us at ${phoneDisplay}. Tap "Call Clinic" below to speak with our team directly.`,
  appointment:
    `To book an appointment, please call us at ${phoneDisplay} during clinic hours (Mon–Sat, 8 AM–1 PM). Walk-ins are welcome, but appointments are recommended.`,
  services:
    'We offer comprehensive eye exams, cataract evaluation, glaucoma screening, contact lens fitting, pediatric eye care, diabetic eye care, LASIK consultation, and eye infection treatment.',
  referral:
    'No referral is needed. You can call us or walk in during clinic hours. Appointments are recommended for dedicated time with the doctor.',
  firstVisit:
    'For your first visit, please bring previous eye prescriptions, medical records, current medications, ID proof, and your glasses or contact lenses if you use them.',
  fallback:
    `I'm not sure about that. For medical advice or specific concerns, please call our clinic at ${phoneDisplay}. Our team will be happy to assist you.`,
};
---

<div id="chatbot-root" class="chatbot-root fixed z-50 pointer-events-none">
  <!-- Chat Panel (fixed between top safe area and launcher) -->
  <div
    id="chatbot-panel"
    class="chatbot-panel hidden fixed flex flex-col w-[min(calc(100vw-2rem),24rem)] sm:w-96 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden min-h-0 pointer-events-auto"
    role="dialog"
    aria-label="Chat with Dr Siddharth Chatbot Agent"
    aria-hidden="true"
  >
    <!-- Header -->
    <div class="bg-primary text-white px-4 py-3 flex items-center gap-3 flex-shrink-0">
      <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
        </svg>
      </div>
      <div class="min-w-0">
        <p class="font-bold text-sm leading-tight truncate">{agentName}</p>
        <p class="text-xs text-white/80 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
          Online · Clinic assistant
        </p>
      </div>
    </div>

    <!-- Messages -->
    <div id="chatbot-messages" class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3 bg-surface"></div>

    <!-- Quick Replies -->
    <div id="chatbot-quick-replies" class="px-3 pb-2 flex flex-wrap gap-2 bg-surface border-t border-gray-100 flex-shrink-0 max-h-28 overflow-y-auto"></div>

    <!-- Input -->
    <div class="p-3 bg-white border-t border-gray-100 flex-shrink-0">
      <form id="chatbot-form" class="flex gap-2">
        <input
          id="chatbot-input"
          type="text"
          placeholder="Type your question..."
          class="flex-1 min-w-0 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
          autocomplete="off"
        />
        <button
          type="submit"
          class="px-3 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors flex-shrink-0"
          aria-label="Send message"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
      <a
        href={`tel:${phone}`}
        class="mt-2 flex items-center justify-center gap-2 w-full py-2 text-sm font-semibold text-primary border border-primary/20 rounded-lg hover:bg-primary/5 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call Clinic: {phoneDisplay}
      </a>
    </div>
  </div>

  <!-- Launcher -->
  <div id="chatbot-launcher" class="chatbot-launcher pointer-events-auto">
    <!-- Floating invite label -->
    <div
      id="chatbot-invite"
      class="chatbot-invite flex items-center gap-2 bg-white text-heading text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl shadow-lg border border-primary/10 pointer-events-none"
    >
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
      </span>
      Ask Dr Siddharth AI
      <span class="text-primary">→</span>
    </div>

    <button
      id="chatbot-toggle"
      type="button"
      class="chatbot-toggle relative w-16 h-16 rounded-full flex items-center justify-center transition-transform duration-300 hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
      aria-label="Open chat with Dr Siddharth Chatbot Agent"
      aria-expanded="false"
    >
      <!-- Animated pulse rings -->
      <span id="chatbot-pulse-1" class="chatbot-pulse chatbot-pulse-1 absolute inset-0 rounded-full bg-primary/30"></span>
      <span id="chatbot-pulse-2" class="chatbot-pulse chatbot-pulse-2 absolute inset-0 rounded-full bg-primary/20"></span>

      <!-- Main button body -->
      <span class="relative z-10 w-full h-full rounded-full bg-gradient-to-br from-primary via-blue-500 to-blue-700 p-1 shadow-[0_8px_30px_rgba(37,99,235,0.4)] flex items-center justify-center overflow-hidden">
        <span class="chatbot-shine absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent"></span>

        <!-- Open: clinic eye icon in white disc -->
        <span id="chatbot-icon-open" class="relative z-10 w-[calc(100%-6px)] h-[calc(100%-6px)] rounded-full bg-white flex items-center justify-center shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="chatbot-eye-icon">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3.25"/>
            <circle cx="12" cy="12" r="1" fill="#2563EB" stroke="none"/>
          </svg>
          <!-- Small chat hint -->
          <span class="absolute -bottom-0.5 -right-0.5 w-5 h-5 rounded-full bg-accent flex items-center justify-center shadow-md border-2 border-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="white" stroke="none" aria-hidden="true">
              <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
            </svg>
          </span>
        </span>

        <!-- Close -->
        <svg id="chatbot-icon-close" class="hidden relative z-10" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </span>

      <!-- Online indicator -->
      <span id="chatbot-badge" class="absolute top-0 right-0 z-20 w-3.5 h-3.5 rounded-full bg-green-500 border-2 border-white shadow-sm chatbot-badge"></span>
    </button>
  </div>
</div>

<style>
  .chatbot-root {
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
  }

  @media (min-width: 640px) {
    .chatbot-root {
      right: max(1.5rem, env(safe-area-inset-right));
      bottom: max(1.5rem, env(safe-area-inset-bottom));
    }
  }

  .chatbot-panel {
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(5.25rem + env(safe-area-inset-bottom));
    top: max(0.75rem, env(safe-area-inset-top));
    max-height: none;
  }

  @media (min-width: 640px) {
    .chatbot-panel {
      right: max(1.5rem, env(safe-area-inset-right));
      bottom: calc(5.75rem + env(safe-area-inset-bottom));
      top: max(1rem, env(safe-area-inset-top));
    }
  }

  .chatbot-launcher {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .chatbot-launcher {
      right: max(1.5rem, env(safe-area-inset-right));
      bottom: max(1.5rem, env(safe-area-inset-bottom));
      gap: 0.625rem;
    }
  }
  .chatbot-invite {
    animation: chatbot-float-label 3s ease-in-out infinite;
  }

  .chatbot-pulse {
    animation: chatbot-pulse-ring 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .chatbot-pulse-2 {
    animation-delay: 0.8s;
  }

  .chatbot-shine {
    transform: translateX(-120%) skewX(-12deg);
    animation: chatbot-shine 4s ease-in-out infinite;
  }

  .chatbot-badge {
    animation: chatbot-badge-pulse 2s ease-in-out infinite;
  }

  .chatbot-eye-icon {
    animation: chatbot-eye-blink 5s ease-in-out infinite;
  }

  .chatbot-toggle:hover .chatbot-shine {
    animation-duration: 1.5s;
  }

  .chatbot-toggle:hover .chatbot-eye-icon {
    transform: scale(1.05);
    transition: transform 0.2s ease;
  }

  #chatbot-launcher.is-open .chatbot-invite,
  #chatbot-launcher.is-open .chatbot-pulse,
  #chatbot-launcher.is-open .chatbot-badge {
    animation: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  #chatbot-launcher.is-open .chatbot-invite {
    display: none;
  }

  #chatbot-launcher.is-open .chatbot-pulse {
    display: none;
  }

  @keyframes chatbot-float-label {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  @keyframes chatbot-pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  @keyframes chatbot-shine {
    0%, 70%, 100% { transform: translateX(-120%) skewX(-12deg); }
    35% { transform: translateX(120%) skewX(-12deg); }
  }

  @keyframes chatbot-badge-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    50% { box-shadow: 0 0 0 4px rgba(34, 197, 94, 0); }
  }

  @keyframes chatbot-eye-blink {
    0%, 42%, 44%, 100% { transform: scaleY(1); }
    43% { transform: scaleY(0.12); }
  }

  @keyframes chatbot-badge-bounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
</style>

<script define:vars={{ quickReplies, responses }}>
  const panel = document.getElementById('chatbot-panel');
  const launcher = document.getElementById('chatbot-launcher');
  const toggle = document.getElementById('chatbot-toggle');
  const messagesEl = document.getElementById('chatbot-messages');
  const quickRepliesEl = document.getElementById('chatbot-quick-replies');
  const form = document.getElementById('chatbot-form');
  const input = document.getElementById('chatbot-input');
  const iconOpen = document.getElementById('chatbot-icon-open');
  const iconClose = document.getElementById('chatbot-icon-close');

  let isOpen = false;
  let hasGreeted = false;

  const keywordMap = [
    { keys: ['hour', 'timing', 'time', 'open', 'close', 'when'], id: 'hours' },
    { keys: ['address', 'location', 'where', 'find', 'direction', 'map'], id: 'address' },
    { keys: ['phone', 'call', 'contact', 'number', 'mobile'], id: 'contact' },
    { keys: ['appointment', 'book', 'schedule', 'visit'], id: 'appointment' },
    { keys: ['service', 'treatment', 'offer', 'cataract', 'glaucoma', 'lasik'], id: 'services' },
    { keys: ['referral', 'refer'], id: 'referral' },
    { keys: ['first visit', 'bring', 'documents', 'what to bring'], id: 'firstVisit' },
    { keys: ['hello', 'hi', 'hey', 'namaste'], id: 'greeting' },
  ];

  function getResponse(id) {
    if (id === 'greeting') return responses.greeting;
    return responses[id] || responses.fallback;
  }

  function matchInput(text) {
    const lower = text.toLowerCase().trim();
    if (!lower) return null;

    for (const entry of keywordMap) {
      if (entry.keys.some((key) => lower.includes(key))) {
        return entry.id;
      }
    }
    return null;
  }

  function appendMessage(text, sender) {
    const bubble = document.createElement('div');
    bubble.className = sender === 'user'
      ? 'flex justify-end'
      : 'flex justify-start';

    const inner = document.createElement('div');
    inner.className = sender === 'user'
      ? 'max-w-[85%] px-3 py-2 rounded-2xl rounded-br-md bg-primary text-white text-sm leading-relaxed whitespace-pre-line'
      : 'max-w-[85%] px-3 py-2 rounded-2xl rounded-bl-md bg-white border border-gray-100 text-body text-sm leading-relaxed shadow-sm whitespace-pre-line';

    inner.textContent = text;
    bubble.appendChild(inner);
    messagesEl.appendChild(bubble);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function renderQuickReplies() {
    quickRepliesEl.innerHTML = '';
    quickReplies.forEach((reply) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-1.5 text-xs font-medium text-primary bg-white border border-primary/20 rounded-full hover:bg-primary/10 transition-colors';
      btn.textContent = reply.label;
      btn.addEventListener('click', () => handleUserMessage(reply.label, reply.id));
      quickRepliesEl.appendChild(btn);
    });
  }

  function handleUserMessage(label, responseId) {
    appendMessage(label, 'user');
    setTimeout(() => {
      appendMessage(getResponse(responseId), 'bot');
    }, 400);
  }

  function handleTextInput(text) {
    const matchedId = matchInput(text);
    appendMessage(text, 'user');
    setTimeout(() => {
      appendMessage(getResponse(matchedId || 'fallback'), 'bot');
    }, 400);
  }

  function setOpen(open) {
    isOpen = open;
    panel.classList.toggle('hidden', !open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    launcher.classList.toggle('is-open', open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);

    if (!open) {
      panel.style.bottom = '';
      panel.style.top = '';
    } else {
      updatePanelBounds();
    }

    if (open && !hasGreeted) {
      hasGreeted = true;
      appendMessage(responses.greeting, 'bot');
      renderQuickReplies();
      requestAnimationFrame(() => {
        messagesEl.scrollTop = messagesEl.scrollHeight;
      });
    }

    if (open) {
      setTimeout(() => input.focus(), 100);
    }
  }

  // Keep panel within viewport if launcher size changes (e.g. invite label)
  function updatePanelBounds() {
    if (!launcher || !panel) return;

    const launcherRect = launcher.getBoundingClientRect();
    const viewport = window.visualViewport;
    const viewportHeight = viewport?.height ?? window.innerHeight;
    const viewportTop = viewport?.offsetTop ?? 0;
    const gap = 12;

    panel.style.top = `${Math.max(viewportTop + 8, 12)}px`;
    panel.style.bottom = `${viewportHeight + viewportTop - launcherRect.top + gap}px`;
  }

  const resizeObserver = typeof ResizeObserver !== 'undefined'
    ? new ResizeObserver(() => { if (isOpen) updatePanelBounds(); })
    : null;

  if (resizeObserver && launcher) {
    resizeObserver.observe(launcher);
  }

  window.addEventListener('resize', () => { if (isOpen) updatePanelBounds(); });
  window.addEventListener('orientationchange', () => {
    setTimeout(() => { if (isOpen) updatePanelBounds(); }, 150);
  });
  window.visualViewport?.addEventListener('resize', () => { if (isOpen) updatePanelBounds(); });
  window.visualViewport?.addEventListener('scroll', () => { if (isOpen) updatePanelBounds(); });

  toggle.addEventListener('click', () => {
    const nextOpen = !isOpen;
    setOpen(nextOpen);
    if (nextOpen) updatePanelBounds();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    handleTextInput(text);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });
</script>
