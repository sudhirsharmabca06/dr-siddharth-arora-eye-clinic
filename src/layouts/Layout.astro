---
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Dr Siddharth Arora Eye Clinic | Eye Specialist in Bharatpur, Rajasthan",
  description = "Dr Siddharth Arora Eye Clinic offers comprehensive eye care services in Bharatpur, Rajasthan. Expert ophthalmologist providing cataract, glaucoma, LASIK, and pediatric eye care."
} = Astro.props;

const clinicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Dr Siddharth Arora Eye Clinic',
  url: 'https://draroraeyecare.com/',
  telephone: '+91-95874-56565',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '169, Krishna Nagar',
    addressLocality: 'Bharatpur',
    addressRegion: 'Rajasthan',
    postalCode: '321001',
    addressCountry: 'IN',
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="keywords" content="eye doctor, ophthalmologist, eye clinic, Bharatpur, Rajasthan, cataract, glaucoma, LASIK, eye exam, Dr Siddharth Arora" />
  <meta name="author" content="Dr Siddharth Arora Eye Clinic" />
  <meta name="theme-color" content="#0D7377" />
  <link rel="canonical" href="https://draroraeyecare.com/" />
  <script type="application/ld+json" set:html={JSON.stringify(clinicSchema)}></script>

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_IN" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>{title}</title>

  <slot name="head" />
</head>
<body class="bg-white antialiased">
  <slot />
</body>
</html>
